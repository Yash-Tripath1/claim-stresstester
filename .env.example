# Research Claim Stress-Tester — environment template
#
# Live Meta-model inference is DISABLED by default and makes no call unless
# STRESSTEST_PROPOSER is set AND a token is supplied. The demo runs fully
# offline with the deterministic fallback proposer if nothing is set.
#
# We use FREE Meta open-weight (Llama) models via card-free partner hosts —
# NOT the Meta Model API (its $150 hackathon credits still require a card).
# Never put real keys in the repository; use a local .env or the environment.

# --- Proposer mode: offline (default) | cloudflare | openai ---
STRESSTEST_PROPOSER=offline

# --- Cloudflare Workers AI (free account, NO credit card) ---
# Create a free Cloudflare account, then an API token with Workers AI: Run
# and invoke permission. No card, no billing. 10,000 Neurons/day free (hard cap).
STRESSTEST_API_KEY=
STRESSTEST_BASE_URL=https://api.cloudflare.com/client/v4/ai/run
STRESSTEST_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# --- OVHcloud AI Endpoints (anonymous, no signup, no card) ---
# Uncomment to use OVH instead. Anonymous tier: 2 RPM per IP per model.
# STRESSTEST_API_KEY=anonymous
# STRESSTEST_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# STRESSTEST_MODEL=Meta-Llama-3_3-70B-Instruct
